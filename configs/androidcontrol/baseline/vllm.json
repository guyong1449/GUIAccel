{
  "benchmark": "AndroidControl",
  "paths": {
    "dataset_manifest": "data/androidcontrol/manifest.json",
    "base_model_path": "models/Qwen3-VL-8B-Instruct"
  },
  "model": {
    "backend": "vllm",
    "source": "models/Qwen3-VL-8B-Instruct",
    "model_name": "Qwen3-VL-8B-Instruct",
    "served_model_name": "Qwen3-VL-8B"
  },
  "service": {
    "api_base": "http://127.0.0.1:8000/v1",
    "api_key": "EMPTY",
    "served_model_name": "Qwen3-VL-8B"
  },
  "fallback": {
    "temperature": 0.0,
    "top_p": 1.0,
    "max_new_tokens": 2048,
    "repetition_penalty": 1.0,
    "image_max_pixels": 1000000
  },
  "evaluation": {
    "android_instruction_modes": [
      "high_level",
      "low_level"
    ],
    "microbatch_caps": {
      "sample_cap_per_gpu": 2,
      "image_cap_per_gpu": 16,
      "visual_token_cap_per_gpu": 8192,
      "text_token_cap_per_gpu": 32768,
      "progress_flush_interval_examples": 16
    }
  },
  "backend": {
    "kind": "vllm",
    "image_input_mode": "base64_data_url",
    "allow_local_file_urls": false,
    "request_retries": 3,
    "retry_backoff_seconds": 0.5,
    "client_max_parallel_requests": 2,
    "default_image_max_pixels": 1000000
  }
}
