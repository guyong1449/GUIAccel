# GUIAccel environment
# Reuses SkillReuse's conda env, model, and data.

export GUIACCEL_REPO_ROOT="/dkucc/home/rw335/GUIAccel"

# Conda environment (shared with SkillReuse)
export GUIACCEL_CONDA_PREFIX="/dkucc/home/rw335/.conda/envs/skillreuse-fa2"

# Model path (symlinked to SkillReuse/models)
export GUIACCEL_BASE_MODEL_PATH="${GUIACCEL_REPO_ROOT}/models/Qwen3-VL-8B-Instruct"

# Dataset path (symlinked to SkillReuse/data)
export GUIACCEL_ANDROIDCONTROL_DATASET_MANIFEST="${GUIACCEL_REPO_ROOT}/data/androidcontrol/manifest.json"

# vLLM service ports
export GUIACCEL_FRONT_PORT="8000"
export GUIACCEL_BASE_PORT="8100"

# Also keep SkillReuse env vars for backward compat with data/model loaders
export SKILLREUSE_REPO_ROOT="/dkucc/home/rw335/SkillReuse"
export SKILLREUSE_BASE_MODEL_PATH="/dkucc/home/rw335/SkillReuse/models/Qwen3-VL-8B-Instruct"
export SKILLREUSE_ANDROIDCONTROL_DATASET_MANIFEST="/dkucc/home/rw335/SkillReuse/data/androidcontrol/manifest.json"
